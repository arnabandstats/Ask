# Copy this file to .env and fill in your own values. .env is git-ignored — never commit it.
# On Databricks, don't use a .env file: store the key in a secret scope and let
# databricks_launcher_cluster.ipynb read it (see README → Running on Databricks).

# Standard OpenAI
OPENAI_API_KEY=

# Azure OpenAI (set USE_AZURE_OPENAI=true and fill these instead)
USE_AZURE_OPENAI=false
AZURE_OPENAI_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_VERSION=2025-03-01-preview

# Optional model overrides
# OPENAI_DEPLOYMENT_NAME=gpt-5.6-luna
# ASK_DEEP_MODEL=gpt-5.6-sol
# ASK_REASONING_EFFORT=medium

# Validation library
# ASK_VALIDATION_SEED=20240601     # random seed used by every test (bootstrap, noise, sampling)
# ASK_JUDGE_MODEL=gpt-5.6-luna       # model for LLM-judge tests (GenAI); blank = the default model
# ASK_SQL_WAREHOUSE_ID=            # Databricks SQL warehouse for Unity Catalog tables (no Spark session)
# ASK_MAX_TABLE_ROWS=2000000       # bigger tables are hash-sampled deterministically
